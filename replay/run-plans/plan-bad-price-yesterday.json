{
  "id": "plan-bad-price-yesterday",
  "version": 1,
  "risk": "write",
  "match": {
    "operation": "assess",
    "subject": "pricing",
    "topic": "bad_price_yesterday",
    "key": "Task 1: purchase dispute: bad price yesterday."
  },
  "requires": [
    "email"
  ],
  "steps": [
    {
      "id": "pull_up_account",
      "tool": "pull_up_account",
      "args": {
        "email": "$.bind.email"
      },
      "guards": [
        {
          "ref": "$.s.pull_up_account.found",
          "op": "true",
          "why": "account found"
        }
      ]
    },
    {
      "id": "record_reason",
      "tool": "record_reason",
      "write": true,
      "args": {
        "email": "$.bind.email",
        "orderId": "-",
        "reason": "bad price yesterday"
      }
    },
    {
      "id": "pick_order",
      "tool": "pick_order",
      "args": {
        "orders": "$.s.pull_up_account.account.orders",
        "orderId": "$.bind.order_id",
        "preferRefunded": false
      },
      "guards": [
        {
          "ref": "$.s.pick_order.id",
          "op": "exists",
          "why": "one unambiguous order"
        }
      ]
    },
    {
      "id": "verify_identity",
      "tool": "verify_identity",
      "args": {
        "name": "$.s.pull_up_account.account.name",
        "accountId": "$.s.pull_up_account.account.accountId",
        "orderId": "$.s.pick_order.id"
      },
      "guards": [
        {
          "ref": "$.s.verify_identity.verified",
          "op": "true",
          "why": "identity verified"
        }
      ]
    },
    {
      "id": "membership",
      "tool": "membership",
      "args": {
        "email": "$.bind.email"
      }
    },
    {
      "id": "check_system",
      "tool": "check_system",
      "args": {
        "email": "$.bind.email",
        "question": "Is the customer's bad price yesterday claim a company error?"
      }
    },
    {
      "id": "promo_rule",
      "tool": "policy_check",
      "args": {
        "rule": "promo_allowed",
        "level": "$.s.membership.level",
        "answer": "$.s.check_system.answer"
      }
    },
    {
      "id": "promo_code",
      "tool": "promo_code",
      "write": true,
      "args": {
        "email": "$.bind.email",
        "reason": "bad price yesterday",
        "percent": 10
      },
      "guards": [
        {
          "ref": "$.s.promo_rule.ok",
          "op": "true",
          "why": "policies/membership: level may get a new code and system confirms company error"
        }
      ]
    }
  ],
  "reply": "Hi {{s.pull_up_account.account.name|first}}, thanks for reaching out — I've verified your account and order.\n\nPrices on our site can shift day to day: our pricing algorithms adjust dynamically based on demand and inventory, so an item can be cheaper one day and back up the next. That change isn't something we're able to control or roll back, and I'm sorry for the frustration.\n\nWhat I can do is help close the gap — here's a {{s.promo_code.percent}}% off promo code for you: **{{s.promo_code.code}}**, valid through {{s.promo_code.expires}}. Just apply it at checkout on the {{s.pick_order.items.0.name}}.\n\nAnything else I can help you with?",
  "source": {
    "procedureId": "proc-10",
    "intent": "bad_price_yesterday",
    "uses": 3,
    "examples": 1,
    "replyTemplate": "model"
  },
  "compiledAt": "2026-09-27T22:40:17.573Z",
  "enabled": false,
  "shadowPending": true
}
