{
  "name": "Own Your Intelligence UI",
  "version": "1.0.0",
  "description": "Portable UI tokens. CSS-ready strings; keys map directly to --ui-{key}. Edit this file, then run node design-system/build-tokens.mjs.",
  "global": {
    "font-display": "\"Funnel Display\", system-ui, sans-serif",
    "font-body": "\"Funnel Sans\", system-ui, sans-serif",
    "font-mono": "\"Fragment Mono\", ui-monospace, Menlo, monospace",
    "text-caption": "0.78125rem",
    "text-small": "0.8125rem",
    "text-body": "0.875rem",
    "text-reading": "0.9375rem",
    "text-lead": "1.0625rem",
    "text-section": "1.25rem",
    "text-title": "1.625rem",
    "text-metric": "2.75rem",
    "text-hero": "clamp(2.75rem, 6vw, 4.5rem)",
    "weight-regular": "400",
    "weight-medium": "500",
    "leading-tight": "1.1",
    "leading-body": "1.5",
    "tracking-display": "-0.035em",
    "space-1": "0.25rem",
    "space-2": "0.5rem",
    "space-3": "0.75rem",
    "space-4": "1rem",
    "space-5": "1.25rem",
    "space-6": "1.5rem",
    "space-8": "2rem",
    "space-10": "2.5rem",
    "space-12": "3rem",
    "space-16": "4rem",
    "space-24": "6rem",
    "radius-small": "0.25rem",
    "radius-control": "0.375rem",
    "radius-panel": "0.75rem",
    "border-width": "1px",
    "focus-width": "2px",
    "control-compact": "2.25rem",
    "control-default": "2.75rem",
    "layout-max": "75rem",
    "layout-reading": "65ch",
    "layout-form": "32rem",
    "layout-header": "4rem",
    "layout-gutter": "clamp(1rem, 4vw, 3rem)",
    "duration-fast": "120ms",
    "duration-base": "180ms",
    "duration-slow": "260ms",
    "ease-out": "cubic-bezier(0.22, 1, 0.36, 1)",
    "layer-sticky": "10",
    "layer-popover": "20",
    "layer-dialog": "30"
  },
  "themes": {
    "dark": {
      "bg": "#0A0A0B",
      "surface": "#111113",
      "overlay": "#1B1C1F",
      "fg": "#EDEBE7",
      "muted": "#A3A5AB",
      "subtle": "#90949C",
      "disabled": "#666A73",
      "line": "#2D2E33",
      "border": "#45474F",
      "border-control": "#747882",
      "hover": "#242529",
      "selected": "#2D2E33",
      "accent": "#FF8A3D",
      "accent-soft": "#342217",
      "success": "#91CCA0",
      "warning": "#E9C46A",
      "danger": "#FF8D84",
      "info": "#97BCEB",
      "primary-bg": "#EDEBE7",
      "primary-fg": "#15161A",
      "primary-hover": "#FFFFFF",
      "focus": "#EDEBE7",
      "bar-bg": "#F6F4F0",
      "bar-fg": "#15161A",
      "bar-muted": "#5B6068",
      "bar-line": "#D8D6D2",
      "bar-active": "#E5E3DF",
      "scrim": "rgb(0 0 0 / 65%)",
      "shadow-overlay": "0 16px 48px rgb(0 0 0 / 35%)"
    },
    "light": {
      "bg": "#EDEBE7",
      "surface": "#F6F4F0",
      "overlay": "#FFFFFF",
      "fg": "#15161A",
      "muted": "#50555E",
      "subtle": "#626670",
      "disabled": "#93969C",
      "line": "#D4D2CD",
      "border": "#ABA9A4",
      "border-control": "#7A7C81",
      "hover": "#E4E2DE",
      "selected": "#DDDBD6",
      "accent": "#A5440D",
      "accent-soft": "#F9E4D6",
      "success": "#266B3A",
      "warning": "#765509",
      "danger": "#B12E27",
      "info": "#315F99",
      "primary-bg": "#15161A",
      "primary-fg": "#F6F4F0",
      "primary-hover": "#33353B",
      "focus": "#15161A",
      "bar-bg": "#F6F4F0",
      "bar-fg": "#15161A",
      "bar-muted": "#5B6068",
      "bar-line": "#D8D6D2",
      "bar-active": "#E5E3DF",
      "scrim": "rgb(21 22 26 / 45%)",
      "shadow-overlay": "0 16px 48px rgb(21 22 26 / 16%)"
    }
  },
  "breakpoints": {
    "compact": "35rem",
    "stack": "60rem"
  }
}
